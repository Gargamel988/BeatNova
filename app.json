{
  "expo": {
    "name": "beatnova",
    "slug": "beatnova",
    "scheme": "beatnova",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/beatnovalogo.jpeg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/beatnovalogo.jpeg",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.INTERNET"
      ],
      "package": "com.gargamel9288.beatnova"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/beatnovalogo.jpeg"
    },
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-file-system",
      [
        "expo-media-library",
        {
          "androidPermissions": ["android.permission.READ_MEDIA_AUDIO"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/beatnovalogo.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "backgroundColor": "#E6F4FE"
          }
        }
      ],
      [
        "expo-audio",
        {
          "ios": {
            "usesAudioSession": true
          },
          "android": {
            "playInBackground": true,
            "enableMediaControls": true
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1444133443338193~5350662155",
          "iosAppId": "ca-app-pub-1444133443338193~5350662155"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad693689-0a5a-4ded-8394-23fb6aa18978"
      }
    },
    "owner": "gargamel123"
  }
}
